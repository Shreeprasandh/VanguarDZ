# ===================================================================
# 🌌 VANGUARDZ ENVIRONMENT VARIABLES CONFIGURATION
# ===================================================================

# Supabase Project Credentials (required for pilot accounts, checkouts, leaderboards)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# WebSocket Server URL (optional override)
# Defaults to ws://localhost:3000 locally, or wss://vanguardz.onrender.com for remote / desktop builds
# VITE_WS_URL=wss://your-custom-backend.com

# Backend Express/WebSocket Server Listening Port (Default: 3000)
PORT=3000

# Desktop Installer Download Link (for game website download button)
VITE_DOWNLOAD_URL=https://drive.google.com/uc?export=download&id=your_file_id
